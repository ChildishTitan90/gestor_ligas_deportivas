model appeal_decisions {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  appeal_id            String                @db.Uuid
  outcome              String
  decided_by           String                @db.Uuid
  new_ruling_id        String?               @db.Uuid
  reason               String
  issued_at            DateTime              @default(now()) @db.Timestamptz(6)
  appeals              appeals               @relation(fields: [appeal_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                users                 @relation(fields: [decided_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  disciplinary_rulings disciplinary_rulings? @relation(fields: [new_ruling_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([appeal_id], map: "fk_appeal_decisions_appeal_id_fkey")
  @@index([decided_by], map: "fk_appeal_decisions_decided_by_fkey")
  @@index([new_ruling_id], map: "fk_appeal_decisions_new_ruling_id_fkey")
  @@schema("sports_management")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model appeal_evidence {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  appeal_id String  @db.Uuid
  file_id   String  @db.Uuid
  appeals   appeals @relation(fields: [appeal_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  files     files   @relation(fields: [file_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([appeal_id, file_id])
  @@index([file_id], map: "fk_appeal_evidence_file_id_fkey")
  @@schema("sports_management")
}

