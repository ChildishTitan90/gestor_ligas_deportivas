model venue_loans {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  season_id              String                   @db.Uuid
  venue_id               String                   @db.Uuid
  club_id                String                   @db.Uuid
  letter_file_id         String                   @db.Uuid
  status                 String                   @default("PENDING")
  approved_by            String?                  @db.Uuid
  approved_at            DateTime?                @db.Timestamptz(6)
  home_venue_assignments home_venue_assignments[]
  users                  users?                   @relation(fields: [approved_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  clubs                  clubs                    @relation(fields: [club_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  files                  files                    @relation(fields: [letter_file_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  seasons                seasons                  @relation(fields: [season_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  venues                 venues                   @relation(fields: [venue_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([approved_by], map: "fk_venue_loans_approved_by_fkey")
  @@index([club_id], map: "fk_venue_loans_club_id_fkey")
  @@index([letter_file_id], map: "fk_venue_loans_letter_file_id_fkey")
  @@index([season_id], map: "fk_venue_loans_season_id_fkey")
  @@index([venue_id], map: "fk_venue_loans_venue_id_fkey")
  @@schema("sports_management")
}

