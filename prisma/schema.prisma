/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model venues {
  id                       String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  league_id                String                   @db.Uuid
  code                     String
  name                     String
  address                  String
  is_league_sports_complex Boolean                  @default(false)
  owner_club_id            String?                  @db.Uuid
  features                 Json                     @default("{}")
  is_active                Boolean                  @default(true)
  home_venue_assignments   home_venue_assignments[]
  matches                  matches[]
  venue_availability       venue_availability[]
  venue_loans              venue_loans[]
  venue_reservations       venue_reservations[]
  leagues                  leagues                  @relation(fields: [league_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  clubs                    clubs?                   @relation(fields: [owner_club_id, league_id], references: [id, league_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([id, league_id])
  @@unique([league_id, code])
  @@index([owner_club_id, league_id], map: "fk_venues_owner_club_id_league_id_fkey")
  @@schema("sports_management")
}

