  venue_id  String   @db.Uuid
  starts_at DateTime @db.Timestamptz(6)
  ends_at   DateTime @db.Timestamptz(6)
  type      String
  reason    String?
  venues    venues   @relation(fields: [venue_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([venue_id], map: "fk_venue_availability_venue_id_fkey")
  @@index([venue_id, starts_at, ends_at], map: "venue_availability_date")
  @@schema("sports_management")
}

