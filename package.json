{
  "name": "gestor_ligas_deportivas",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x",
    "npm": ">=11.19.0 <12"
  },
  "packageManager": "npm@11.19.0",
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "prisma@7.10.1": true,
    "argon2@0.45.1": true,
    "esbuild@0.28.2": true,
    "unrs-resolver": false,
    "fsevents": false
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --incremental false",
    "postinstall": "prisma generate",
    "test:ci": "node --test scripts/ci/migration-helpers.test.mjs scripts/ci/production-plans.test.mjs scripts/ci/preview-fixture-target.test.mjs scripts/preview/connection.test.mjs",
    "test:preview-runtime": "node scripts/test-auth.mjs --preview",
    "preview:maintain": "node scripts/preview/maintain.mjs",
    "test:database-config": "node --conditions=react-server --import tsx --test src/server/db/connection-options.test.ts",
    "test:authorization": "node scripts/test-auth.mjs --authorization",
    "test:session-policy": "node --conditions=react-server --import tsx --test src/server/auth/session-policy.test.ts",
    "test:login-policy": "node --conditions=react-server --import tsx --test src/server/auth/login-policy.test.ts",
    "test:auth": "npm run test:session-policy && npm run test:login-policy && node scripts/test-auth.mjs",
    "seed:dev": "node --conditions=react-server --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/seed-auth-dev.mjs",
    "auth:demo": "node scripts/test-auth.mjs --demo",
    "db:seed": "prisma db seed",
    "test:seed": "node scripts/test-seed.mjs",
    "ci:guard-migrations": "node scripts/ci/guard-migrations.mjs",
    "ci:database": "node scripts/ci/verify-database.mjs",
    "test:account-form": "node --import tsx --test src/features/accounts/form-input.test.ts src/features/accounts/account-form.test.tsx",
    "test:team-registration-form": "node --import tsx --test src/features/clubs/team-registration-form.test.tsx",
    "test:team-registration-http": "node --import tsx --test src/features/clubs/team-registration-http.test.tsx",
    "test:session-activity": "node --import tsx --test src/features/auth/components/session-activity.test.mjs",
    "test:team-registration": "npm run test:team-registration-form && npm run test:team-registration-list && npm run test:team-registration-http && npm run test:session-activity",
    "test:team-registration-browser": "node --test tests/e2e/team-registration-session.test.mjs",
    "test:team-registration-list": "node --import tsx --test src/features/clubs/team-registration-list.test.tsx",
    "test:affiliation-review": "node --import tsx --test src/features/clubs/affiliation-review.test.tsx src/features/clubs/resubmit-affiliation.client.test.tsx",
    "test:affiliation-input": "node --import tsx --test src/features/clubs/affiliation-submission.test.ts src/features/clubs/schemas.test.ts",
    "test:affiliations": "node scripts/test-auth.mjs --affiliations",
    "test:team-enrollments": "node scripts/test-auth.mjs --team-enrollments",
    "test:team-enrollment-client": "node --import tsx --test src/features/clubs/team-enrollment-recovery.client.test.ts",
    "test:signatures": "node --conditions=react-server --import tsx --test src/features/clubs/server/signature-validation.test.ts src/features/clubs/server/signature-upload-ticket.test.ts src/features/clubs/server/signature-binding.test.ts tests/integration/signature-stored-content.test.ts src/features/clubs/upload-signature.client.test.ts src/features/clubs/submit-affiliation.client.test.ts src/features/clubs/affiliation-feedback.test.ts scripts/verification/signature-download-check.test.ts",
    "verify:signature-download": "node --conditions=react-server --import tsx scripts/verify-signature-download.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@supabase/supabase-js": "2.118.0",
    "argon2": "0.45.1",
    "lucide-react": "1.56.0",
    "next": "16.4.3",
    "next-auth": "4.24.15",
    "pdf-lib": "1.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "20.19.43",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "17.4.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "pg": "8.23.1",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
