# Base local: cada integrante debe elegir su propia contraseña al iniciar.
# Usa letras y numeros para evitar tener que codificar caracteres en la URL.
LOCAL_DB_PASSWORD="REEMPLAZAR_CON_PASSWORD_LOCAL"
DATABASE_URL="postgresql://postgres:REEMPLAZAR_CON_PASSWORD_LOCAL@localhost:5433/gestor_ligas_dev"
DIRECT_URL="postgresql://postgres:REEMPLAZAR_CON_PASSWORD_LOCAL@localhost:5433/gestor_ligas_dev"

# Opcional, solo servidor: CA en PEM para conectar la aplicación a Supabase.
# En Vercel se pega el contenido del .crt, no su ruta local. Omitir en Docker.
# DATABASE_CA_CERT="REEMPLAZAR_CON_CONTENIDO_PEM"

# NextAuth 4: generar un secreto local distinto para cada integrante.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="REEMPLAZAR_CON_SECRETO_GENERADO"

# Inactividad real, validada en servidor usando sessions.last_activity_at.
AUTH_IDLE_TIMEOUT_MINUTES=30
# Intentos: entero decimal 1–20; bloqueo: minutos enteros 1–1440.
# Ausentes usan 5/15. Valores inválidos rechazan el acceso, sin fallback silencioso.
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# Firmas privadas: configuración exclusiva del servidor del entorno de pruebas.
# Solicitar los valores al responsable del proyecto; nunca usar NEXT_PUBLIC_ para la clave.
# SUPABASE_URL="https://REEMPLAZAR_CON_PROYECTO_DE_PRUEBAS.supabase.co"
# SUPABASE_STORAGE_SERVER_KEY="REEMPLAZAR_CON_CLAVE_DE_SERVIDOR"
# SUPABASE_SIGNATURES_BUCKET="firmas-afiliacion"
# SUPABASE_PLAYER_DOCUMENTS_BUCKET="expedientes-jugadores"
# SUPABASE_REFEREE_CREDENTIALS_BUCKET="acreditaciones-arbitros"
# SUPABASE_VENUE_LOAN_LETTERS_BUCKET="cartas-prestamo-canchas"

# Verificamex CURP: solo servidor. Las consultas reales las prueban humanos.
# Nunca usar NEXT_PUBLIC_. Los agentes solo usan transporte simulado.
# VMX_API_KEY="REEMPLAZAR_CON_TOKEN_PRIVADO"

# PDGLD-119: activación explícita; dejar deshabilitado hasta configurar el canal.
ACCOUNT_EMAIL_ENABLED=false
ACCOUNT_EMAIL_PROVIDER=resend
RESEND_API_KEY=REEMPLAZAR_CON_CLAVE_PRIVADA
ACCOUNT_EMAIL_FROM=remitente@dominio-verificado.example
# NEXTAUTH_URL debe ser el origen HTTPS público sin ruta, usuario ni parámetros.

# Firmas privadas de cédulas: configurar bucket privado antes de usar el transporte remoto.
SUPABASE_REPORT_SIGNATURES_BUCKET=cedulas-firmas
# PDGLD-32: deshabilitado hasta definir política y verificar el entorno.
PASSWORD_RECOVERY_ENABLED=false
PASSWORD_RECOVERY_TTL_MINUTES=
PASSWORD_RECOVERY_MAX_PER_HOUR=

# PDGLD-32: cuotas públicas compartidas. Vacías = recuperación deshabilitada.
# Ventana 60..3600 s. Valores requieren decisión documentada para cada entorno.
PASSWORD_RECOVERY_RATE_WINDOW_SECONDS=
PASSWORD_RECOVERY_REQUESTS_PER_IP=
PASSWORD_RECOVERY_COMPLETIONS_PER_IP=
PASSWORD_RECOVERY_REQUESTS_GLOBAL=
PASSWORD_RECOVERY_COMPLETIONS_GLOBAL=
# Clave aleatoria privada, al menos 32 caracteres; nunca NEXT_PUBLIC_.
PASSWORD_RECOVERY_RATE_SECRET=
# vercel (requiere VERCEL=1 y cabecera fijada por plataforma) o local (solo loopback/dev).
PASSWORD_RECOVERY_CLIENT_IP_MODE=
