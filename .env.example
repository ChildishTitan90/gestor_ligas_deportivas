# Base local: cada integrante debe elegir su propia contraseña al iniciar.
# Usa letras y numeros para evitar tener que codificar caracteres en la URL.
LOCAL_DB_PASSWORD="REEMPLAZAR_CON_PASSWORD_LOCAL"
DATABASE_URL="postgresql://postgres:REEMPLAZAR_CON_PASSWORD_LOCAL@localhost:5433/gestor_ligas_dev"
DIRECT_URL="postgresql://postgres:REEMPLAZAR_CON_PASSWORD_LOCAL@localhost:5433/gestor_ligas_dev"

# Opcional, solo servidor: CA en PEM para conectar la aplicación a Supabase.
# En Vercel se pega el contenido del .crt, no su ruta local. Omitir en Docker.
# DATABASE_CA_CERT="REEMPLAZAR_CON_CONTENIDO_PEM"

# NextAuth 4: generar un secreto local distinto para cada integrante.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="REEMPLAZAR_CON_SECRETO_GENERADO"

# Inactividad real, validada en servidor usando sessions.last_activity_at.
AUTH_IDLE_TIMEOUT_MINUTES=30
# Intentos: entero decimal 1–20; bloqueo: minutos enteros 1–1440.
# Ausentes usan 5/15. Valores inválidos rechazan el acceso, sin fallback silencioso.
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
